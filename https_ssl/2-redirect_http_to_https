global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    ssl-default-bind-options no-sslv3

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend www-http
    bind *:80
    mode http
    http-request redirect scheme https code 301 unless { ssl_fc }

frontend www-https
    bind *:443 ssl crt /etc/haproxy/certs/www.<YOUR-DOMAIN>.pem
    mode http
    default_backend web-backend

backend web-backend
    mode http
    balance roundrobin
    server web-01 18.170.29.94:80 check
    server web-02 18.130.92.32:80 check
